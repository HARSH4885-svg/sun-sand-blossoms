# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Event details (optional overrides; defaults live in src/lib/config.ts) ---
NEXT_PUBLIC_EVENT_DATE=
NEXT_PUBLIC_EVENT_VENUE=
NEXT_PUBLIC_SUBMISSION_DEADLINE=

# --- Eligibility ---
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=iiita.ac.in
